import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SetupWindow inherits Window {
    in property <image> app-icon;
    in property <string> app-name: "Verse 浏览器";
    in property <float> progress: 0.0;
    in property <string> sub-text: "安装";

    // 步骤控制: 0=Welcome, 1=Installing, 2=Complete
    in-out property <int> current-step: 0;

    callback window-move(length, length);
    callback close();
    callback start-install();
    callback launch-app();

    width: 480px;
    height: 360px;
    title: "Verse";
    icon: app-icon;
    no-frame: true;
    background: #0a0a0a;

    // 主内容区域
    VerticalLayout {
        width: 100%;
        height: 100%;

        // 可拖拽的顶部栏
        Rectangle {
            height: 48px;

            TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if (self.pressed) {
                        root.window-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }

            // 关闭按钮
            close-btn := TouchArea {
                x: parent.width - 32px;
                y: 8px;
                width: 24px;
                height: 24px;
                clicked => {
                    root.close();
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: close-btn.has-hover ? #ef4444 : transparent;
                    border-radius: 6px;

                    Path {
                        width: 10px;
                        height: 10px;
                        stroke: close-btn.has-hover ? #ffffff : #525252;
                        stroke-width: 1.5px;
                        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                        x: 7px;
                        y: 7px;
                    }
                }
            }
        }

        // 内容区域
                VerticalLayout {
            padding: 32px;
            padding-top: 10px;
            spacing: 32px;
            alignment: center;

            // Step 0: Welcome 页面
                    if root.current-step == 0: VerticalLayout {
                spacing: 20px;

                // Logo 展示
                        Rectangle {
                    width: 80px;
                    height: 80px;
                    x: parent.width / 2 - self.width / 2;

                    Image {
                        source: @image-url("product_logo_128.png");
                        width: 64px;
                        height: 64px;
                        image-fit: contain;
                    }
                }

                // 欢迎文字
                        VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "欢迎使用 " + root.app-name;
                        font-size: 20px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "点击下方按钮开始安装";
                        font-size: 13px;
                        color: #a3a3a3;
                        horizontal-alignment: center;
                    }
                }

                // 开始安装按钮
                        start-btn := TouchArea {
                    x: parent.width / 2 - self.width / 2;
                    width: 140px;
                    height: 40px;
                    clicked => {
                        root.start-install();
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: start-btn.has-hover ? #e5e5e5 : #ffffff;
                        border-radius: 8px;

                        Text {
                            text: "开始安装";
                            font-size: 14px;

                            color: #000000;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Step 1: Installing 页面
                    if root.current-step == 1: VerticalLayout {
                spacing: 24px;
                alignment: center;

                // 应用图标预览
                        VerticalLayout {
                    spacing: 16px;
                    alignment: center;

                    Rectangle {
                        width: 80px;
                        height: 80px;
                        x: parent.width / 2 - self.width / 2;

                        Image {
                            source: @image-url("product_logo_128.png");
                            width: 64px;
                            height: 64px;
                            image-fit: contain;
                        }
                    }

                    Text {
                        text: root.sub-text + " " + root.app-name;
                        font-size: 20px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // 进度信息
                        VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        Text {
                            text: "0%";
                            color: #a3a3a3;
                            font-size: 12px;
                        }

                        Rectangle { }

                        Text {
                            text: Math.round(root.progress) + "%";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    // 进度条背景
                                Rectangle {
                        height: 6px;
                        background: #262626;
                        border-radius: 3px;
                        clip: true;

                        // 实际进度
                                    Rectangle {
                            x: 0;
                            width: parent.width * Math.max(0, Math.min(1, root.progress / 100));
                            height: 100%;
                            background: #ffffff;
                            border-radius: 3px;

                            animate width {
                                duration: 250ms;
                                easing: ease-out;
                            }
                        }
                    }
                }

                Text {
                    text: "请稍候，正在完成安装...";
                    font-size: 12px;
                    color: #525252;
                    horizontal-alignment: center;
                }
            }

            // Step 2: Complete 页面
                        if root.current-step == 2: VerticalLayout {
                spacing: 20px;
                alignment: center;

                // 成功图标
                            Rectangle {
                    width: 64px;
                    height: 64px;
                    background: #052e16;
                    border-radius: 32px;
                    border-width: 1px;
                    border-color: #166534;
                    x: parent.width / 2 - self.width / 2;

                    // 勾选图标
                                Path {
                        width: 28px;
                        height: 28px;
                        stroke: #22c55e;
                        stroke-width: 3px;
                        commands: "M 4 14 L 11 21 L 24 7";
                        x: 18px;
                        y: 18px;
                    }
                }

                // 完成文字
                            VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "安装完成";
                        font-size: 20px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.app-name + " 已成功安装到您的设备";
                        font-size: 13px;
                        color: #a3a3a3;
                        horizontal-alignment: center;
                    }
                }

                // 按钮区域
                            VerticalLayout {
                    spacing: 10px;
                    alignment: center;

                    // 启动应用按钮
                                launch-btn := TouchArea {
                        x: parent.width / 2 - self.width / 2;
                        width: 160px;
                        height: 40px;
                        clicked => {
                            root.launch-app();
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: launch-btn.has-hover ? #e5e5e5 : #ffffff;
                            border-radius: 8px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: "启动 " + root.app-name;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: #000000;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 退出按钮
                            exit-btn := TouchArea {
                        x: parent.width / 2 - self.width / 2;
                        width: 160px;
                        height: 40px;
                        clicked => {
                            root.close();
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: exit-btn.has-hover ? #262626 : #1a1a1a;
                            border-radius: 8px;

                            Text {
                                text: "退出安装程序";
                                font-size: 13px;
                                color: #a3a3a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

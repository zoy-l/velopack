import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MessageDialog inherits Window {
    in property <string> dialog-title: "Velopack";
    in property <string> heading: "";
    in property <string> text: "";
    in property <string> type: "info"; // info, warning, error, question
    in property <[string]> buttons: ["OK"];

    out property <int> clicked-index: -1;
    callback close-dialog(int);
    callback window-move(length, length);

    width: 420px;
    height: layout.preferred-height;
    title: dialog-title;
    no-frame: true;
    background: transparent;

    layout := VerticalBox {
        padding: 20px;
        alignment: start;

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e5e5e7;
            drop-shadow-blur: 16px;
            drop-shadow-color: rgba(0, 0, 0, 0.15);
            drop-shadow-offset-y: 4px;

            // Title bar area for dragging
            TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 40px;
                moved => {
                    if (self.pressed) {
                        root.window-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                HorizontalBox {
                    padding: 0;
                    spacing: 12px;
                    alignment: start;

                    // Icon
                    Rectangle {
                        width: 40px;
                        height: 40px;

                        Path {
                            width: 100%;
                            height: 100%;
                            fill: {
                                if root.type == "error" {
                                    #ff3b30
                                } else if root.type == "warning" {
                                    #ffcc00
                                } else {
                                    #007aff
                                }
                            }
                            commands: {
                                if root.type == "error" {
                                    "M 20 2 C 10.1 2 2 10.1 2 20 C 2 29.9 10.1 38 20 38 C 29.9 38 38 29.9 38 20 C 38 10.1 29.9 2 20 2 Z M 28 26 L 26 28 L 20 22 L 14 28 L 12 26 L 18 20 L 12 14 L 14 12 L 20 18 L 26 12 L 28 14 L 22 20 L 28 26 Z"
                                } else if root.type == "warning" {
                                    "M 20 4 L 38 34 L 2 34 Z M 18 14 L 18 24 L 22 24 L 22 14 Z M 18 28 L 18 32 L 22 32 L 22 28 Z"
                                } else {
                                    "M 20 2 C 10.1 2 2 10.1 2 20 C 2 29.9 10.1 38 20 38 C 29.9 38 38 29.9 38 20 C 38 10.1 29.9 2 20 2 Z M 18 10 L 22 10 L 22 14 L 18 14 Z M 18 18 L 22 18 L 22 32 L 18 32 Z"
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.heading;
                            font-size: 16px;
                            font-weight: 700;
                            color: #1d1d1f;
                            wrap: word-wrap;
                            visible: root.heading != "";
                        }

                        Text {
                            text: root.text;
                            font-size: 13px;
                            color: #515154;
                            wrap: word-wrap;
                        }
                    }
                }

                // Buttons
                HorizontalBox {
                    padding: 0;
                    spacing: 12px;
                    alignment: end;

                    for btn[i] in root.buttons: Rectangle {
                        min-width: 80px;
                        height: 32px;
                        border-radius: 6px;
                        background: touch.pressed ? #e5e5e7 : (touch.has-hover ? #f2f2f7 : #f5f5f7);
                        border-width: 1px;
                        border-color: #d2d2d7;

                        touch := TouchArea {
                            clicked => {
                                root.close-dialog(i);
                            }
                        }

                        Text {
                            text: btn;
                            color: #000000;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
    }
}

import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MessageDialog inherits Window {
    in property <string> dialog-title: "Velopack";
    in property <string> heading: "";
    in property <string> text: "";
    in property <string> type: "info"; // info, warning, error, question
    in property <[string]> buttons: ["OK"];

    out property <int> clicked-index: -1;
    callback close-dialog(int);

    width: 500px;
    height: 300px; // Dynamic height? Slint windows often need fixed or auto.
    // We'll trust layouts.
    title: dialog-title;
    no-frame: true;
    background: transparent;

    Rectangle {
        background: #ffffff;
        border-radius: 12px;
        border-width: 1px;
        border-color: #e5e5e7;
        drop-shadow-blur: 20px;
        drop-shadow-color: rgba(0, 0, 0, 0.1);
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 24px;

            HorizontalLayout {
                spacing: 20px;
                alignment: start;

                // Icon
                Rectangle {
                    width: 48px;
                    height: 48px;

                    Path {
                        width: 100%;
                        height: 100%;
                        fill: {
                            if root.type == "error" {
                                #ff3b30
                            } else if root.type == "warning" {
                                #ffcc00
                            } else {
                                #007aff
                            }
                        }
                        // Simple Icons using paths
                         commands: {
                            if root.type == "error" {
                                "M 24 2 C 11.8 2 2 11.8 2 24 C 2 36.2 11.8 46 24 46 C 36.2 46 46 36.2 46 24 C 46 11.8 36.2 2 24 2 Z M 34 31 L 31 34 L 24 27 L 17 34 L 14 31 L 21 24 L 14 17 L 17 14 L 24 21 L 31 14 L 34 17 L 27 24 L 34 31 Z"
                            } else if root.type == "warning" {
                                "M 24 4 L 44 42 L 4 42 Z M 22 16 L 22 30 L 26 30 L 26 16 Z M 22 34 L 22 38 L 26 38 L 26 34 Z"
                            } // Triangle rough
                            else {
                                "M 24 2 C 11.8 2 2 11.8 2 24 C 2 36.2 11.8 46 24 46 C 36.2 46 46 36.2 46 24 C 46 11.8 36.2 2 24 2 Z M 22 10 L 26 10 L 26 14 L 22 14 Z M 22 18 L 26 18 L 26 36 L 22 36 Z"
                            } // Info (i)
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: root.heading;
                        font-size: 18px;
                        font-weight: 700;
                        color: #1d1d1f;
                        wrap: word-wrap;
                        visible: root.heading != "";
                    }

                    Text {
                        text: root.text;
                        font-size: 14px;
                        color: #515154;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }

            // Spacer
            Rectangle {
                vertical-stretch: 1;
            }

            // Buttons
            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                for btn[i] in root.buttons: Rectangle {
                    width: 100px; // Minimal width
                    height: 36px;
                    border-radius: 6px;
                    background: touch.pressed ? #e5e5e7 : (touch.has-hover ? #f2f2f7 : #f5f5f7);
                    border-width: 1px;
                    border-color: #d2d2d7;

                    touch := TouchArea {
                        clicked => {
                            root.close-dialog(i);
                        }
                    }

                    Text {
                        text: btn;
                        color: #000000;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 13px;
                    }
                }
            }
        }
    }
}

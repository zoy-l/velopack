// 覆盖/修复对话框
export component OverwriteDialog inherits Window {
    in property <image> app-icon;
    in property <string> app-name: "应用程序";
    in property <string> dialog-type: "repair"; // "repair", "update", "downgrade"
    in property <string> old-version: "";
    in property <string> new-version: "";
    in property <string> install-path: "";

    callback confirm();
    callback cancel();
    callback window-move(length, length);

    width: 560px;
    height: 420px;
    title: app-name + " 安装";
    icon: app-icon;
    no-frame: true;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;
        border-radius: 16px;
        border-width: 1px;
        border-color: #e5e5e7;
        drop-shadow-blur: 40px;
        drop-shadow-color: rgba(0, 0, 0, 0.12);
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 80px;
            drag-touch := TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if (drag-touch.pressed) {
                        root.window-move(drag-touch.mouse-x - drag-touch.pressed-x, drag-touch.mouse-y - drag-touch.pressed-y);
                    }
                }
            }
        }

        VerticalLayout {
            padding: 48px;
            spacing: 28px;
            alignment: start;

            // 图标和标题区
            HorizontalLayout {
                spacing: 20px;
                alignment: start;

                // 应用图标
                Image {
                    source: root.app-icon;
                    width: 64px;
                    height: 64px;
                }

                // 标题和描述
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: {
                            if root.dialog-type == "update" {
                                "发现已安装的旧版本"
                            } else if root.dialog-type == "downgrade" {
                                "发现已安装的新版本"
                            } else {
                                root.app-name + " 已经安装"
                            }
                        }
                        font-size: 24px;
                        font-weight: 700;
                        color: #1d1d1f;
                    }

                    Text {
                        text: {
                            if root.dialog-type == "update" {
                                "是否更新到新版本？"
                            } else if root.dialog-type == "downgrade" {
                                "您已经安装了更新的版本，是否要降级？"
                            } else {
                                "此应用已安装在您的电脑上。如果运行不正常，您可以尝试修复它。"
                            }
                        }
                        font-size: 15px;
                        color: #6e6e73;
                        wrap: word-wrap;
                    }
                }
            }

            // 版本信息卡片
            if root.old-version != "" && root.new-version != "": Rectangle {
                width: 100%;
                height: 90px;
                background: #f5f5f7;
                border-radius: 12px;

                HorizontalLayout {
                    padding: 20px;
                    spacing: 32px;
                    alignment: space-between;

                    // 当前版本
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "当前版本";
                            font-size: 13px;
                            color: #86868b;
                            font-weight: 500;
                        }

                        Text {
                            text: root.old-version;
                            font-size: 18px;
                            color: #1d1d1f;
                            font-weight: 600;
                        }
                    }

                    // 箭头
                    Path {
                        width: 24px;
                        height: 24px;
                        fill: #86868b;
                        commands: "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18";
                        stroke: #86868b;
                        stroke-width: 2px;
                    }

                    // 新版本
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "安装版本";
                            font-size: 13px;
                            color: #86868b;
                            font-weight: 500;
                        }

                        Text {
                            text: root.new-version;
                            font-size: 18px;
                            color: {
                                if root.dialog-type == "update" {
                                    #0071e3
                                } else if root.dialog-type == "downgrade" {
                                    #ff9500
                                } else {
                                    #1d1d1f
                                }
                            }
                            font-weight: 600;
                        }
                    }
                }
            }

            // 按钮区域
            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                // 取消按钮
                Rectangle {
                    width: 140px;
                    height: 44px;
                    background: cancel-touch.pressed ? #e5e5e7 : (cancel-touch.has-hover ? #f0f0f2 : #f5f5f7);
                    border-radius: 10px;

                    Text {
                        text: "取消";
                        font-size: 15px;
                        color: #1d1d1f;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        clicked => {
                            root.cancel();
                        }
                    }

                    animate background { duration: 150ms; }
                }

                // 确认按钮
                Rectangle {
                    width: 140px;
                    height: 44px;
                    background: {
                        if confirm-touch.pressed {
                            #005bb5
                        } else if confirm-touch.has-hover {
                            #0077ed
                        } else if root.dialog-type == "downgrade" {
                            #ff9500
                        } else {
                            #0071e3
                        }
                    }
                    border-radius: 10px;

                    Text {
                        text: {
                            if root.dialog-type == "update" {
                                "更新"
                            } else if root.dialog-type == "downgrade" {
                                "降级"
                            } else {
                                "修复"
                            }
                        }
                        font-size: 15px;
                        color: white;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    confirm-touch := TouchArea {
                        clicked => {
                            root.confirm();
                        }
                    }

                    animate background { duration: 150ms; }
                }
            }
        }
    }
}
